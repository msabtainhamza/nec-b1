{
  "name": "nec-erp",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml --env-file .env down",
    "build": "pnpm -r --filter ./packages/* run build && pnpm -r --filter ./apps/* run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @nec/api run db:migrate",
    "db:seed": "pnpm --filter @nec/api run db:seed",
    "db:reset": "pnpm --filter @nec/api run db:reset",
    "dev:api": "pnpm --filter @nec/api run dev",
    "dev:worker": "pnpm --filter @nec/worker run dev",
    "dev:desktop": "pnpm --filter @nec/desktop run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nec/config": "workspace:*",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
